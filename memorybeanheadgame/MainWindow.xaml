<Window x:Class="memorybeanheadgame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:memorybeanheadgame"
        mc:Ignorable="d"
        Title="Memory Game" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        
        <!-- Left Side -->
        <StackPanel Grid.Column="0" Margin="15" Background="#F0F0F0">
            
            <TextBlock Text="Size:" FontWeight="Bold" Margin="0,0,0,5" HorizontalAlignment="Center"/>
            <ListBox x:Name="SizeListBox" SelectedIndex="1" Margin="0,0,0,15">
                <ListBoxItem Content="4x4" Tag="2"/>
                <ListBoxItem Content="6x6" Tag="4"/>
                <ListBoxItem Content="8x8" Tag="6"/>
            </ListBox>

            <TextBlock Text="Theme:" FontWeight="Bold" Margin="0,0,0,5" HorizontalAlignment="Center"/>
            <ListBox x:Name="ThemeListBox" SelectedIndex="0" Margin="0,0,0,20">
                <ListBoxItem Content="Numbers" Tag="Numbers"/>
                <ListBoxItem Content="Smileys" Tag="Smileys"/>
                <ListBoxItem Content="Countries" Tag="Countries"/>
            </ListBox>

            <Button Content="Start New Game" FontSize="20" Padding="10" Background="Green" Foreground="White" Click="StartButton_Click"/>
            <TextBlock x:Name="AttemptsTextBlock" Text="Attempts: 0" FontSize="14" FontWeight="Bold" Margin="0,30,0,10" HorizontalAlignment="Center"/>
            <TextBlock x:Name="StatusTextBlock" Text="Click Button to Start New Game" FontSize="10" Foreground="DarkRed" TextWrapping="Wrap" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Right Side -->
        <Border Grid.Column="1" Margin="15" BorderBrush="DarkGray" BorderThickness="2" Background="White">
            <Grid x:Name="GameGrid" Margin="5"/>
        </Border>
    </Grid>
</Window>
